# Copy to .env and fill in. This service is meant to run as a separate,
# always-on process from the main Vercel app (see Build Plan Phase 8) —
# Railway/Render, not Vercel.

PORT=4000

# Shared secret the main app must send as the `x-api-key` header on every
# call to POST /whatsapp/send. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_API_KEY=changeme-shared-secret

# Where Baileys persists the logged-in session (useMultiFileAuthState).
# Point this at a persistent volume in production so a redeploy doesn't
# force a re-scan of the QR code (Build Plan Phase 8).
WHATSAPP_SESSION_DIR=./data/wa-session

# Pacing between sends (Build Plan Phase 4) — whatsapp-web.js bans
# aggressively-automated numbers, so this needs to be much larger than the
# email queue's interval. Values are milliseconds.
WHATSAPP_MIN_DELAY_MS=30000
WHATSAPP_MAX_DELAY_MS=90000

# Hard daily send cap (Build Plan Phase 4 / 9). Keep this low.
WHATSAPP_DAILY_CAP=30

# How long to wait for a single send before giving up.
WHATSAPP_SEND_TIMEOUT_MS=30000

# Where queue/counter state is persisted to disk so a restart doesn't lose
# today's send count or reset the daily cap.
WHATSAPP_PERSIST_PATH=./data/whatsapp-state.json

# Optional: how many completed (sent/failed) jobs to keep in memory before
# the oldest are pruned.
WHATSAPP_JOB_RETENTION_LIMIT=500

# Reliability / alerting
WHATSAPP_RETRY_BASE_DELAY_MS=15000
WHATSAPP_ALERT_COOLDOWN_MS=1800000
# Optional generic webhook for disconnect/session/send-failure alerts
WHATSAPP_ALERT_WEBHOOK_URL=
