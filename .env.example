# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model available on OpenRouter (see https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Other options:
# anthropic/claude-sonnet-4
# google/gemini-2.5-flash
# meta-llama/llama-3.3-70b-instruct

# Your app URL (used in OpenRouter request headers)
APP_URL=http://localhost:3000

# Gmail address you're sending FROM
EMAIL_USER=

# Gmail App Password (NOT your normal password) — generate at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
EMAIL_APP_PASSWORD=

# Optional — port for the local server (defaults to 3000)
PORT=3000

# Optional — override where the resume PDF lives (defaults to ./resume/resume.pdf)
RESUME_PATH=
