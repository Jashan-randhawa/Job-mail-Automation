# =============================================================================
# Every variable below is read somewhere in this codebase (verified by
# grepping every process.env.* / process.env[...] reference across server.js,
# api/, config/, and services/). Nothing here is aspirational — if you don't
# see it grepped, it's not in this file.
# =============================================================================

# --- Required ---------------------------------------------------------------
# Without these three, server.js still starts but warns on boot and every
# job fails at draft or send time (see server.js REQUIRED_ENV_VARS check).

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Gmail address you're sending FROM
EMAIL_USER=

# Gmail App Password (NOT your normal password) — generate at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
EMAIL_APP_PASSWORD=

# --- Drafting (services/cerebrasService.js, services/groqRateLimiter.js) ----

# Optional — any model on your Groq account's catalog (see
# https://console.groq.com/docs/models). Defaults to openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-20b

# Optional — Groq's per-minute request/token caps for this account+model, so
# the drafting pipeline paces itself and avoids 429s instead of hitting them.
# Defaults match the published Free plan limits for openai/gpt-oss-20b (see
# https://console.groq.com/docs/rate-limits). If you're on a paid Groq tier
# or a different model, check https://console.groq.com/settings/limits for
# your account's actual current numbers and set these to match.
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=8000

# --- Sending (services/emailService.js) -------------------------------------

# Optional — override where the resume PDF lives (defaults to ./resume/resume.pdf)
RESUME_PATH=

# Optional — reply-to address if different from EMAIL_USER
REPLY_TO_EMAIL=

# Optional — draft-only / dry-run mode. Set to 1 or true to skip real Gmail
# sending entirely: drafts are still generated by Groq and pass the safety
# gate, but instead of sending they're appended to DRY_RUN_LOG_PATH (default
# ./data/drafts.json) as JSON (plain-text body + rendered HTML). Use this to
# review your first 10-20 drafts for tone before risking a real recruiter's
# inbox. Turn it off (unset, or set to 0/false) once you're happy.
DRY_RUN=
DRY_RUN_LOG_PATH=

# --- Candidate profile overrides (config/profile.js) ------------------------
# Normally you don't touch these — put your real data in profile.json
# (gitignored; copy profile.example.json to get started) instead. These env
# vars exist as a *per-field* override on top of profile.json/built-in
# defaults — mainly useful for a one-off deploy where you don't want to ship
# a profile.json at all. Leave them blank if you're using profile.json.
CANDIDATE_NAME=
CONTACT_PHONE=
CONTACT_EMAIL=
PORTFOLIO_LINK=
GITHUB_LINK=
LINKEDIN_LINK=
RESUME_ATTACHMENT_FILENAME=

# Optional — used in the drafting prompt's "logistics" paragraph ("I am a
# {graduationYear} {degree} graduate, available to start {availability}...").
# Update these as your actual situation changes — don't leave a stale
# "final-year"/graduation-year claim in profile.json past the date it stops
# being true.
DEGREE=
GRADUATION_YEAR=
AVAILABILITY=

# Optional — where profile.json is read from (defaults to ./profile.json)
PROFILE_PATH=

# --- Path B send pacing (api/send-outreach.js, Vercel) ----------------------

# Optional — minimum gap between two sends on the Vercel path (defaults to
# 45s, same default as Path A's MIN_SEND_INTERVAL_MS). Enforced server-side:
# a request that arrives before this has elapsed since the last successful
# send gets back HTTP 429 with a `retryAfterMs`, before any Groq call is
# made. Note this is tracked in a plain in-memory variable scoped to
# whichever serverless instance is currently warm, not a shared store — see
# the comment above POST_SEND_COOLDOWN_MS in api/send-outreach.js for what
# that does and doesn't guarantee.
POST_SEND_COOLDOWN_MS=45000

# --- Local server (server.js) -----------------------------------------------

# Optional — port for the local server (defaults to 3000)
PORT=3000

# Set to "test" to suppress server.js's own app.listen() (the test suite
# imports the Express app directly and manages its own listener) — you
# shouldn't need to set this by hand outside of tooling.
NODE_ENV=

# --- Path A batching & send pacing (server.js in-memory queue) --------------
# Jobs assemble into batches before they're eligible to send at all, so
# outreach goes out in small bursts rather than a steady drip. See the
# README's "Batching" section for the full picture.

# Optional — minimum gap between two sends, plus a random jitter added on
# top, so sends don't land at suspiciously exact intervals (defaults: 45s / 20s)
MIN_SEND_INTERVAL_MS=45000
SEND_JITTER_MAX_MS=20000

# Optional — jobs per batch (defaults to 3)
BATCH_SIZE=3

# Optional — delay in ms between a batch locking and it being eligible to
# send (defaults to 2700000 = 45 minutes)
BATCH_DELAY_MS=2700000

# Optional — if a batch never fills up to BATCH_SIZE, promote it anyway
# after this many ms (defaults to 7200000 = 2 hours)
ORPHAN_BATCH_TIMEOUT_MS=7200000

# Optional — timeouts for each phase of a job, and how often the stale-job
# sweep runs to recover anything stuck past its timeout (all in ms; defaults
# below). You're unlikely to need to touch these.
DRAFT_TIMEOUT_MS=60000
SEND_TIMEOUT_MS=60000
WAIT_TIMEOUT_MS=600000
JOB_PROCESSING_TIMEOUT_MS=300000
STALE_SWEEP_INTERVAL_MS=15000

# Optional — rough seconds-per-phase used only to estimate a job's ETA in
# the UI, not to enforce any real timing (defaults below).
ESTIMATED_DRAFT_SECONDS=20
ESTIMATED_SEND_SECONDS=10

# Optional — caps on in-memory history so a long-running instance doesn't
# leak memory: oldest *completed* jobs/batches are pruned once these limits
# are exceeded (active/queued ones are never pruned). Defaults below.
JOB_RETENTION_LIMIT=1000
BATCH_RETENTION_LIMIT=500
JOB_EVENT_LIMIT=50
JOB_LIST_LIMIT=100

# Optional — where queue/batch state is persisted between restarts, and how
# often (defaults below). The directory is created automatically.
QUEUE_PERSIST_PATH=./data/queue-state.json
QUEUE_PERSIST_DEBOUNCE_MS=250

# =============================================================================
# NOTE: an earlier version of this file also listed UPSTASH_REDIS_REST_URL,
# UPSTASH_REDIS_REST_TOKEN, and CRON_SECRET for a "Vercel + Redis queue" path
# (api/*.js + a lib/jobStore.js). That code doesn't exist in this repo —
# api/send-outreach.js is a single-request drafts-and-sends-in-one-call
# handler with no queue and no Redis dependency (see the comment at the top
# of that file). Those three vars were removed here because nothing reads
# them; if you build out that queue path yourself, add them back.
# =============================================================================
